; binkw32.dll (the Halo folder) -- the Bink functions the game calls, under the DLL's decorated export names.
; lib /def makes each import symbol __Name@N and asks the DLL for _Name@N (types/bink.h declares them to match).
LIBRARY binkw32.dll
EXPORTS
    _BinkClose@4
    _BinkCopyToBuffer@28
    _BinkDoFrame@4
    _BinkNextFrame@4
    _BinkOpen@8
    _BinkOpenDirectSound@4
    _BinkPause@8
    _BinkSetSoundSystem@8
    _BinkWait@4
